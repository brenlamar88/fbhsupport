# Set these privately in Vercel, NEVER in browser HTML or GitHub
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_PASSWORD_HASH=YOUR_RANDOM_SALT_HEX:YOUR_SCRYPT_HASH_HEX
SESSION_SECRET=RANDOM_32_PLUS_BYTES_HEX
RATE_LIMIT_SECRET=RANDOM_32_PLUS_BYTES_HEX

# Reuse EXISTING EmailJS service and assignment template.
# EmailJS Account > Security: enable non-browser API requests.
# Both keys should stay in Vercel server-side environment variables.
EMAILJS_SERVICE_ID=service_ucspnwu
EMAILJS_ASSIGN_TEMPLATE_ID=template_i1zrsar
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional: previous requester confirmations were disabled.
EMAILJS_CONFIRM_TEMPLATE_ID=

# Optional:
NTFY_TOPIC=
NTFY_TOKEN=
ENABLE_AI_TRIAGE=false
ANTHROPIC_API_KEY=

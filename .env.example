# Configure these privately in Vercel, not in browser HTML or GitHub
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_PASSWORD_HASH=YOUR_RANDOM_SALT_HEX:YOUR_SCRYPT_HASH_HEX
SESSION_SECRET=RANDOM_32_PLUS_BYTES_HEX
RATE_LIMIT_SECRET=RANDOM_32_PLUS_BYTES_HEX
# Optional after operational/privacy approval:
RESEND_API_KEY=
MAIL_FROM=
NTFY_TOPIC=
NTFY_TOKEN=
# AI triage sends ticket data to an external provider. Disabled by default.
ENABLE_AI_TRIAGE=false
ANTHROPIC_API_KEY=
